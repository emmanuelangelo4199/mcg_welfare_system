# Copy this file to .env and fill in real values.
# Never commit .env or expose these values publicly.

# Required – generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret-key

# Set to False in production
DEBUG=True

# Comma-separated. In production set to your real hostname(s).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF checks, needed when the
# app runs behind an HTTPS proxy. Subdomain wildcards are supported.
# CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com

# Cookies: switch to None/True when the app is viewed inside a cross-site
# HTTPS iframe (e.g. hosted previews), otherwise browsers block cookies.
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False